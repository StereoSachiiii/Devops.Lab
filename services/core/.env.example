# Core Service — Environment Variables
PORT=3003
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5444/appdb?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SESSION_TTL_MINS=60

# Default Localhost Broker Fallbacks
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CLIENT_ID=core-service
RABBITMQ_URL="amqp://guest:guest@127.0.0.1:5672"

# Opt-in Observability (used with dev.full.sh)
# OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# LOKI_URL=http://127.0.0.1:3100
