{
  "name": "devops-learning-platform",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npx --yes kill-port 3000 3002 3003 3004 8005 8443 8001 8444 5444 6380 5672 15672 19092 9092 3001 9090 3200 3100 4318 4317 18080 8090 && wsl docker compose down --remove-orphans && node -e \"fs.rmSync('apps/web/.next', {recursive:true, force:true})\"",
    "dev": "bash dev/dev.sh",
    "dev:sandbox": "bash dev/dev.sandbox.sh",
    "dev:full": "bash dev/dev.full.sh",
    "build:packages": "npm run build --workspace=packages/observability && npm run build --workspace=packages/messaging",
    "stop": "wsl docker compose down --remove-orphans",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:auth": "npm run dev --workspace=services/auth",
    "dev:core": "npm run dev --workspace=services/core",
    "dev:notification": "npm run dev --workspace=services/notification",
    "build:web": "npm run build --workspace=apps/web",
    "setup:firecracker": "bash scripts/setup-kata.sh",
    "stop:all": "docker compose -p rootcause --profile default down -v && pkill -9 -f 'ts-node' || true && pkill -9 -f 'ts-node-dev' || true",
    "db:push": "packages/db/node_modules/.bin/prisma db push --schema=packages/db/prisma/schema.prisma",
    "db:generate": "packages/db/node_modules/.bin/prisma generate --schema=packages/db/prisma/schema.prisma",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:e2e:extended": "vitest run tests/e2e.extended.test.ts",
    "test:e2e:all": "vitest run tests/e2e.test.ts tests/e2e.extended.test.ts",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "kill:services": "pkill -9 -f 'tsx' || true && pkill -9 -f 'ts-node-dev' || true && pkill -9 -f 'ts-node' || true"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.1",
    "pg": "^8.22.0"
  }
}
