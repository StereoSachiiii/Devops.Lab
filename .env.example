# ── Database & Caches ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5444/appdb?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ── Message Broker (Redpanda / Kafka) ─────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_INTERNAL_PORT=9092
KAFKA_PORT=19092
KAFKA_CLIENT_ID=sandbox-worker
KAFKA_GROUP_ID=sandbox-sessions
REDPANDA_CONSOLE_PORT=18080

# ── Security & Cryptography (Placeholders for local dev) ──────────────────────
JWT_SECRET="dev-jwt-secret-key-change-in-prod"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<INSERT_RSA_PRIVATE_KEY_HERE>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<INSERT_RSA_PUBLIC_KEY_HERE>\n-----END PUBLIC KEY-----"
ENCRYPTION_KEY="<INSERT_BASE64_32_BYTE_AES_KEY_HERE>"
JWT_ISSUER=devops-platform
EXPIRY_MFA_TOKEN=5m
DEFAULT_USER_ROLE=LEARNER

# ── Service & Infrastructure Ports ────────────────────────────────────────────
POSTGRES_PORT=5444
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGT_PORT=15672
API_GATEWAY_PORT=8005
API_GATEWAY_SECURE_PORT=8443
API_GATEWAY_ADMIN_PORT=8001
API_GATEWAY_ADMIN_SECURE_PORT=8444
WEB_FRONTEND_PORT=3000
AUTH_SERVICE_PORT=3002
CORE_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
SANDBOX_WORKER_PORT=8090

# ── Observability Ports ───────────────────────────────────────────────────────
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
LOKI_PORT=3100
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317
LOG_LEVEL=info
LOG_DIR=logs
LOKI_URL=http://localhost:3100
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ── Third-Party OAuth & External APIs ─────────────────────────────────────────
GOOGLE_CLIENT_ID="placeholder_google_client_id"
GOOGLE_CLIENT_SECRET="placeholder_google_client_secret"
GITHUB_CLIENT_ID="placeholder_github_client_id"
GITHUB_CLIENT_SECRET="placeholder_github_client_secret"
GEMINI_API_KEY="placeholder_gemini_api_key"
RESEND_API_KEY="placeholder_resend_api_key"

# ── Application URLs ──────────────────────────────────────────────────────────
NODE_ENV=development
BASE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:8005
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
SESSION_TTL_MINS=60
GUEST_TRIAL_TTL_MINS=10
MAX_MEMORY_MB=512
MAX_CPUS=1.0
OUTBOX_INTERVAL_MS=2000
